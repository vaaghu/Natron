              ],
              "path": [
                "livestats"
              ]
            },
            "description": "Rosters: names, shirt numbers, starters, on court.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": {\n    \"type\": \"teams\",\n    \"messageId\": 1,\n    \"teams\": [\n      {\n        \"teamNumber\": 1,\n        \"detail\": {\n          \"teamName\": \"Home City\",\n          \"teamNickname\": \"City\",\n          \"teamCode\": \"HOM\",\n          \"isHomeCompetitor\": 1\n        },\n        \"coach\": {\n          \"firstName\": \"Ann\",\n          \"familyName\": \"Coach\"\n        },\n        \"players\": [\n          {\n            \"pno\": 1,\n            \"shirtNumber\": \"7\",\n            \"firstName\": \"Sam\",\n            \"familyName\": \"Smith\",\n            \"scoreboardName\": \"S. SMITH\",\n            \"playingPosition\": \"G\",\n            \"starter\": 1,\n            \"captain\": 1,\n            \"active\": 1\n          },\n          {\n            \"pno\": 2,\n            \"shirtNumber\": \"4\",\n            \"firstName\": \"Alex\",\n            \"familyName\": \"Rivers\",\n            \"scoreboardName\": \"A. RIVERS\",\n            \"playingPosition\": \"F\",\n            \"starter\": 1,\n            \"active\": 1\n          },\n          {\n            \"pno\": 3,\n            \"shirtNumber\": \"12\",\n            \"firstName\": \"Bob\",\n            \"familyName\": \"Bench\",\n            \"scoreboardName\": \"B. BENCH\",\n            \"starter\": 0,\n            \"active\": 0\n          }\n        ]\n      },\n      {\n        \"teamNumber\": 2,\n        \"detail\": {\n          \"teamName\": \"Visitors BC\",\n          \"teamNickname\": \"Visitors\",\n          \"teamCode\": \"VIS\",\n          \"isHomeCompetitor\": 0\n        },\n        \"players\": [\n          {\n            \"pno\": 1,\n            \"shirtNumber\": \"9\",\n            \"firstName\": \"Ian\",\n            \"familyName\": \"Fischer\",\n            \"scoreboardName\": \"I. FISCHER\",\n            \"starter\": 1,\n            \"active\": 1\n          }\n        ]\n      }\n    ]\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted', () => pm.response.to.have.status(200));",
                  "pm.sendRequest({url: pm.variables.replaceIn('{{baseUrl}}/state'), header: {Authorization: 'Bearer ' + pm.collectionVariables.get('token')}}, (err, res) => {",
                  "  pm.test('scoreboard.home.player.7.name is Sam Smith', () => pm.expect(String(res.json()['scoreboard.home.player.7.name'].value)).to.eql('Sam Smith'));",
                  "});"
                ]
              }
            }
          ]
        },
