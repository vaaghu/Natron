{
  "info": {
    "_postman_id": "961d2b56-ea1b-5605-8c5e-9f29efd62100",
    "name": "Natron - FIBA LiveStats feed",
    "description": "Feeds Natron's LiveStats feed by hand and controls it.\n\n\"Feed\" starts, stops and checks the feed (TV feed host or online match). \"Messages\" POSTs LiveStats TV feed messages to `/livestats`, read exactly as if they came over the TCP feed, and sets the `scoreboard.*` keys (bind Text nodes to them). Send Teams first: the other messages refer to players by pno.\n\nSet `baseUrl` if Natron uses another port (NATRON_HTTP_PORT) and `token` if it was started with NATRON_HTTP_TOKEN.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Feed",
      "item": [
