              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const us = eval(pm.collectionVariables.get('ultraScoreLib'))(pm);",
                  "const start = { period: 1, minutes: 10, seconds: 0, tenths: 0, clockRunning: 1, shotSeconds: 24, shotTenths: 0,",
                  "  timeoutSeconds: 0, homeScore: 0, awayScore: 0, homeFouls: 0, awayFouls: 0, homeTimeouts: 2, awayTimeouts: 2,",
                  "  possession: 'home' };",
                  "Object.keys(start).forEach((k) => us.set(k, start[k]));",
                  "pm.variables.set('fromVariables', '1');",
                  "pm.variables.set('packet', us.general());"
                ]
              }
            }
          ]
