                "type": "text/javascript",
                "exec": [
                  "const us = eval(pm.collectionVariables.get('ultraScoreLib'))(pm);",
                  "us.set('period', us.num('period') + 1);",
                  "const overtime = us.num('period') > 4;",
                  "us.set('minutes', overtime ? 5 : 10);",
                  "us.set('seconds', 0);",
                  "us.set('tenths', 0);",
                  "us.set('clockRunning', 0);",
                  "us.set('shotSeconds', 24);",
                  "us.set('shotTenths', 0);",
                  "if (us.num('period') === 3 || overtime) { us.set('homeFouls', 0); us.set('awayFouls', 0); }",
                  "pm.variables.set('fromVariables', '1');",
                  "pm.variables.set('packet', us.general());"
                ]
              }
            }
          ]
        }
