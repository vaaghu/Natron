        {
          "name": "Clock -1 s",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/scoreboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "scoreboard"
              ]
            },
            "description": "Run it repeatedly (Collection Runner, with a delay of 1000 ms) for a running clock.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"packet\": \"{{packet}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const us = eval(pm.collectionVariables.get('ultraScoreLib'))(pm);",
                  "let total = us.num('minutes') * 60 + us.num('seconds');",
                  "if (total > 0) total -= 1;",
                  "us.set('minutes', Math.floor(total / 60));",
                  "us.set('seconds', total % 60);",
                  "us.set('tenths', 0);",
                  "const shot = us.num('shotSeconds');",
                  "if (shot > 0) us.set('shotSeconds', shot - 1);",
                  "pm.variables.set('fromVariables', '1');",
                  "pm.variables.set('packet', us.general());"
                ]
              }
            }
          ]
        },
