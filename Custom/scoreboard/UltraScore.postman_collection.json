{
  "info": {
    "_postman_id": "e99d49eb-086d-5b1a-baf1-2734a3d3f588",
    "name": "Natron - Ultra Score scoreboard feed",
    "description": "Simulates an Ultra Score scoreboard console feeding Natron.\n\nThe console sends binary UDP packets to port 2800; Postman cannot send UDP, so these requests POST the same packets (as hex) to `/scoreboard` on Natron's HTTP API, which decodes them exactly like UDP ones and sets the `scoreboard.*` state keys (bind Text nodes to them).\n\nThe \"Game\" requests build the packet from the collection variables (homeScore, minutes, period, ...) and change them first, e.g. \"Home +2\". Start with \"Tip-off\". Run \"Clock -1 s\" in the Collection Runner with a 1000 ms delay for a running clock.\n\nSet `baseUrl` if Natron uses another port (NATRON_HTTP_PORT) and `token` if it was started with NATRON_HTTP_TOKEN.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Builds Ultra Score \"Data Out\" packets (hex) from the collection variables.",
          "// Request scripts use it with:",
          "//   const us = eval(pm.collectionVariables.get('ultraScoreLib'))(pm);",
          "function ultraScoreLib(pm) {",
          "  const num = (name) => parseInt(pm.collectionVariables.get(name), 10) || 0;",
          "  const set = (name, value) => pm.collectionVariables.set(name, String(value));",
          "  const hex = (bytes) => bytes.map((b) => (b & 0xff).toString(16).toUpperCase().padStart(2, '0')).join(' ');",
          "  const shirt = (no) => {",
          "    const s = String(no).slice(0, 3);",
          "    return [0, 1, 2].map((i) => (i < s.length ? s.charCodeAt(i) : 0));",
          "  };",
          "  const packet = (idHigh, body) =>",
          "    hex([0xff, 0xfe, idHigh, 0x01, 0x01, body.length & 0xff, body.length >> 8, ...body, 0xfd, 0xfc]);",
          "",
          "  return {",
          "    num, set, hex,",
          "    // General data (01 01): period, clock, shot clock, timeout, score, fouls, timeouts, possession.",
          "    general() {",
          "      const possession = pm.collectionVariables.get('possession');",
          "      const timeout = num('timeoutSeconds');",
          "      return packet(0x01, [",
          "        num('period'),",
          "        num('clockRunning') ? 0x11 : 0x10,",
          "        num('minutes'), num('seconds'), num('tenths'),",
          "        num('shotSeconds'), num('shotTenths'),",
          "        timeout > 0 ? timeout : 0xff,",
          "        0x00, 0x00,",
          "        num('homeScore'), num('awayScore'),",
          "        num('homeFouls'), num('awayFouls'),",
          "        num('homeTimeouts'), num('awayTimeouts'),",
          "        possession === 'home' ? 1 : 0, possession === 'away' ? 1 : 0,",
          "      ]);",
          "    },",
          "    // Player data (02 01 home / 03 01 away): [[shirt, points, fouls], ...], 20 entries.",
          "    players(team, list) {",
          "      const body = [];",
          "      for (let i = 0; i < 20; ++i) {",
          "        const p = list[i];",
          "        body.push(...(p ? [...shirt(p[0]), p[1], p[2]] : [0, 0, 0, 0, 0]));",
          "      }",
          "      return packet(team === 'home' ? 0x02 : 0x03, body);",
          "    },",
          "    // Players on court (06 01 home / 07 01 away): [[shirt, onCourt], ...], 20 entries.",
          "    onCourt(team, list) {",
          "      const body = [];",
          "      for (let i = 0; i < 20; ++i) {",
          "        const p = list[i];",
          "        body.push(...(p ? [...shirt(p[0]), p[1] ? 1 : 0] : [0, 0, 0, 0]));",
          "      }",
          "      return packet(team === 'home' ? 0x06 : 0x07, body);",
          "    },",
          "  };",
          "}",
          "pm.collectionVariables.set('ultraScoreLib', '(' + ultraScoreLib.toString() + ')');"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// POST /scoreboard with a general packet built from the variables: the",
          "// decoded score must be the variables' score.",
          "const isFeed = pm.request.url.getPath() === '/scoreboard' && pm.request.method === 'POST';",
          "if (isFeed && pm.variables.get('fromVariables') === '1') {",
          "  pm.test('score decoded as sent', () => {",
          "    pm.response.to.have.status(200);",
          "    const v = pm.response.json().values;",
          "    pm.expect(v['scoreboard.home.score'].value).to.eql(parseInt(pm.collectionVariables.get('homeScore'), 10));",
          "    pm.expect(v['scoreboard.away.score'].value).to.eql(parseInt(pm.collectionVariables.get('awayScore'), 10));",
          "  });",
          "}"
        ]
      }
    }
  ],
